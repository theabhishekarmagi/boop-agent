# Copy these NONSECRET settings to the repository's ignored .env.local.
# Local operator research only; production mode and customer workspaces refuse this feature.
BOOP_STAGEHAND_ENABLED=true
BOOP_STAGEHAND_ORIGINS=https://docs.stagehand.dev,https://www.stagehand.dev
BOOP_STAGEHAND_HEADLESS=true
# Optional. macOS auto-detects installed Chrome, then Brave. Uses a NEW temporary profile.
# BOOP_STAGEHAND_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# No Browserbase key or separate Stagehand model key is required for this adapter.
